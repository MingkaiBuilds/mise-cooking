{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mise.cooking/schemas/golden-set.v1.schema.json",
  "title": "Mise permission-safe golden evaluation set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "description", "license", "authorityReferences", "cases"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "license": { "const": "CC0-1.0" },
    "authorityReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 30,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "anyOf"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "anyOf": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "safetyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "anyOf", "mustAlsoInclude", "authorityUrl"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "anyOf": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "mustAlsoInclude": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "authorityUrl": { "type": "string", "format": "uri" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "language", "outputLanguage", "cuisineTags", "techniqueTags", "dietaryTags", "evidenceQuality", "evidence", "request", "expected", "rights", "review"],
      "properties": {
        "id": { "type": "string", "pattern": "^mise-seed-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "outputLanguage": { "type": "string", "minLength": 2 },
        "cuisineTags": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "techniqueTags": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "dietaryTags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidenceQuality": { "enum": ["clear", "missing-quantity", "contradictory", "adversarial"] },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["caption", "visualNotes"],
          "properties": {
            "caption": { "type": "string", "minLength": 1 },
            "visualNotes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["servings", "dietary"],
          "properties": {
            "servings": { "type": "integer", "minimum": 1, "maximum": 12 },
            "dietary": { "type": "string" }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredIngredients", "forbiddenIngredients", "requiredConcepts", "confidenceCeiling", "safetyRules"],
          "properties": {
            "requiredIngredients": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assertion" } },
            "forbiddenIngredients": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "requiredConcepts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assertion" } },
            "confidenceCeiling": { "enum": ["high", "medium", "low"] },
            "safetyRules": { "type": "array", "items": { "$ref": "#/$defs/safetyRule" } }
          }
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fixtureOrigin", "license"],
          "properties": {
            "fixtureOrigin": { "const": "mise-authored-synthetic" },
            "license": { "const": "CC0-1.0" }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "notes"],
          "properties": {
            "status": { "enum": ["draft", "culinary-reviewed", "safety-reviewed", "approved"] },
            "notes": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
