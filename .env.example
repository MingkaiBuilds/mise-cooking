# Keep generation paused until the key, database, evals, and runtime guardrails are verified.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GENERATION_ENABLED=false
RATE_LIMIT_SALT=

# One-time founding pilot pool; BUDGET_PERIOD must not rotate automatically.
PILOT_BUDGET_USD=200
BUDGET_PERIOD=founding-pilot-2026
GENERATION_RESERVATION_USD=0.02

# Anonymous abuse controls and cache lifetime.
DAILY_GENERATION_LIMIT=300
USER_DAILY_GENERATION_LIMIT=8
HOURLY_REQUEST_LIMIT=120
CACHE_TTL_DAYS=90

# Verify these against the model-specific pricing page before enabling generation.
MODEL_INPUT_USD_PER_MILLION=0.20
MODEL_OUTPUT_USD_PER_MILLION=1.20
